# 게이트웨이(Rust)와 관리 API(TS)가 공유. 32자 이상.
JOIN_TOKEN_SECRET=
# 관리 API /v1/admin/* Bearer 토큰. 16자 이상.
ADMIN_API_TOKEN=

# gateway
GATEWAY_PUBLIC_ADDR=0.0.0.0:8080
GATEWAY_INTERNAL_ADDR=127.0.0.1:9090
ROOM_FLUSH_INTERVAL_MS=200
ROOM_MAX_MESSAGES_PER_FLUSH=200
ROOM_BROADCAST_CAPACITY=64
SESSION_SEND_TIMEOUT_MS=5000
SESSION_RATE_LIMIT_BURST=5
SESSION_RATE_LIMIT_PER_SEC=1
SESSION_MAX_TEXT_CHARS=300
SESSION_MAX_FRAME_BYTES=4096

# api
API_PORT=4000
GATEWAY_INTERNAL_URL=http://127.0.0.1:9090
GATEWAY_PUBLIC_WS_URL=ws://localhost:8080/ws
WEB_ORIGIN=http://localhost:3100

# 메시지 저장소 (로컬은 docker compose의 Postgres)
DATABASE_URL=postgres://chat:chat@127.0.0.1:5432/chat
TEST_DATABASE_URL=postgres://chat:chat@127.0.0.1:5432/chat_test
STORE_QUEUE_CAPACITY=10000
STORE_BATCH_MAX_MESSAGES=500
STORE_MAX_CONNECTIONS=4
HISTORY_PAGE_SIZE=50
# 방 유효기간. 만든 지 이 시간이 지나면 자동으로 닫힌다.
ROOM_TTL_HOURS=24

# 전체 기록 보관 (Parquet 파일). 화면에 못 나간 글까지 전부 쌓는다.
ARCHIVE_DIR=data/archive
ARCHIVE_FLUSH_INTERVAL_SECS=30
ARCHIVE_MAX_MESSAGES_PER_FILE=100000
ARCHIVE_QUEUE_CAPACITY=100000
